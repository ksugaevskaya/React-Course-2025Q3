// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`uncontrolled component validation 1`] = `
<div>
  <form>
    <label
      for="fname"
    >
      First name:
    </label>
    <input
      data-testid="fname"
      id="fname"
      name="fname"
      placeholder="Write your name"
      type="text"
    />
    <label
      for="age"
    >
      Age:
    </label>
    <input
      data-testid="age"
      id="age"
      name="age"
      placeholder="Write your age"
      type="text"
    />
    <label
      for="email"
    >
      Email:
    </label>
    <input
      data-testid="email"
      id="email"
      name="email"
      type="text"
    />
    <label
      for="password"
    >
      Password:
    </label>
    <input
      data-testid="password"
      id="password"
      name="password"
      type="password"
    />
    <label
      for="passwordRepeat"
    >
      Repeat password:
    </label>
    <input
      data-testid="passwordRepeated"
      id="passwordRepeat"
      name="passwordRepeat"
      type="password"
    />
    <p>
      Gender:
    </p>
    <input
      id="female"
      name="gender"
      type="radio"
      value="female"
    />
    <label
      for="female"
    >
      Female
    </label>
    <input
      id="male"
      name="gender"
      type="radio"
      value="male"
    />
    <label
      for="male"
    >
      Male
    </label>
    <input
      data-testid="check-box"
      id="checkbox"
      name="checkbox"
      type="checkbox"
    />
    <label
      for="checkbox"
    >
       Accept Terms and Conditions agreement
    </label>
    <label
      for="file"
    >
       Upload picture:
    </label>
    <input
      id="file"
      name="file"
      type="file"
    />
    <input
      data-testid="submit"
      disabled=""
      type="submit"
      value="Submit"
    />
  </form>
</div>
`;
